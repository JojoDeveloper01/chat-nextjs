# chat-nextjs production environment example
# Copy to .env and fill real values. Never commit .env.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Internal compose database URL
DATABASE_URL=postgresql://chat_nextjs:${POSTGRES_PASSWORD}@postgres:5432/chat_nextjs?schema=public

# Required: at least 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars

# Optional. Set only when you need cookies shared across subdomains, e.g. .example.com
# Leave empty/unset for host-only cookies.
COOKIE_DOMAIN=

POSTGRES_DB=chat_nextjs
POSTGRES_USER=chat_nextjs
POSTGRES_PASSWORD=replace-with-a-strong-random-db-password
