{
  "name": "chat-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec ts-node --project tsconfig.server.json server.ts",
    "clean": "rimraf dist",
    "build": "next build && tsc --project tsconfig.server.json",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "next lint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@types/cookie": "1.0.0",
    "@types/js-cookie": "3.0.6",
    "bcryptjs": "3.0.3",
    "cookie": "1.1.1",
    "js-cookie": "3.0.5",
    "jsonwebtoken": "9.0.3",
    "next": "16.1.1",
    "nodemon": "3.1.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "ts-node": "10.9.2",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3",
    "@tailwindcss/postcss": "4",
    "@types/bcryptjs": "3.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.0.3",
    "@types/react": "19",
    "@types/react-dom": "19",
    "cross-env": "10.1.0",
    "eslint": "9",
    "eslint-config-next": "16.1.1",
    "prisma": "^6.0.0",
    "rimraf": "6.1.2",
    "tailwindcss": "4",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}